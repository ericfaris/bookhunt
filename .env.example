# Mobilism forum login (used once at app startup to establish a session)
MOBILISM_USER=your_username
MOBILISM_PASS=your_password

# Optional: premium downloader login. If set, it is loaded into memory at
# startup so you don't have to type it in the UI each session. The in-app
# credentials form still overrides these at any time.
MOBILISM_PREMIUM_USER=
MOBILISM_PREMIUM_PASS=

# Where downloaded files are saved.
# On native Windows: C:\epubs
# On WSL pointing at the Windows drive, use: /mnt/c/epubs
DOWNLOAD_PATH=C:\epubs

# Port for the local web app
PORT=3000

# Optional: forum base URL (rarely needs changing)
# MOBILISM_BASE=https://forum.mobilism.org

# Optional: run the browser headless (true) or visible (false). Default: true
# HEADLESS=true

# --- Notifications + Send-to-Kindle (Gmail SMTP) ----------------------------
# Used to (a) email a book's cover/details to recipients and (b) push the .epub
# to their @kindle.com address. Needs a Gmail App Password (account must have
# 2FA enabled) — your normal password will NOT work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ericfaris@gmail.com
SMTP_PASS=                                  # 16-char Gmail App Password
SMTP_FROM=Mobilism Finder <ericfaris@gmail.com>

# --- Reserved for the future Twilio SMS/MMS channel (not yet active) ---------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=                               # your Twilio number, e.g. +15551234567
