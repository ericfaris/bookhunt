# Mobilism forum login (used once at app startup to establish a session)
MOBILISM_USER=your_username
MOBILISM_PASS=your_password

# Optional: premium downloader login. If set, it is loaded into memory at
# startup so you don't have to type it in the UI each session. The in-app
# credentials form still overrides these at any time.
MOBILISM_PREMIUM_USER=
MOBILISM_PREMIUM_PASS=

# Where downloaded files are saved when STORAGE=local (ignored with STORAGE=r2,
# which production uses — see "Book storage" below).
# On native Windows: C:\epubs   On WSL/Linux: e.g. ./downloads
DOWNLOAD_PATH=C:\epubs

# Port for the local web app
PORT=3000

# --- Cloudflare Access origin verification (STRONGLY recommended) ------------
# The app is exposed through a Cloudflare Tunnel. Setting these makes the origin
# verify Cloudflare's signed Access JWT on every request (and /warm WebSocket),
# so it FAILS CLOSED if someone reaches the tunnel directly or the Access policy
# is ever loosened. Leave blank for purely-local dev (verification is skipped and
# a warning is logged).
#   CF_ACCESS_TEAM_DOMAIN: your team domain, e.g. yourname.cloudflareaccess.com
#   CF_ACCESS_AUD: the Application Audience (AUD) tag from the Access app
#     (Cloudflare Zero Trust > Access > Applications > your app > Overview).
#   CF_ACCESS_ALLOWED_EMAILS: optional extra allowlist (comma-separated) checked
#     against the token's email claim on top of the Access policy.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_ALLOWED_EMAILS=ericfaris@gmail.com

# Optional: forum base URL (rarely needs changing)
# MOBILISM_BASE=https://forum.mobilism.org

# Optional: run the browser headless (true) or visible (false). Default: true
# HEADLESS=true

# --- Notifications + Send-to-Kindle (Gmail SMTP) ----------------------------
# Used to (a) email a book's cover/details to recipients and (b) push the .epub
# to their @kindle.com address. Needs a Gmail App Password (account must have
# 2FA enabled) — your normal password will NOT work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ericfaris@gmail.com
SMTP_PASS=                                  # 16-char Gmail App Password
SMTP_FROM=BookHunt <ericfaris@gmail.com>

# --- Auto-warm (keeps the Mobilism session logged in unattended) -------------
# A background watcher re-clears Cloudflare + logs in on its own, so /warm is only
# needed for an interactive Cloudflare challenge. All optional — sane defaults:
# AUTO_WARM=false                            # set to disable the watcher entirely
# AUTO_WARM_INTERVAL_MS=20000                # how often to check the session
# AUTO_WARM_BACKOFF_MS=90000                 # pause after a CF block so a human can solve it
# PUBLIC_URL=https://bookhunt.mooseflip.com      # used for the /warm link in alert emails
# WARM_ALERT_EMAIL=                          # who to email when a human IS needed
#                                            # (defaults to CF_ACCESS_ALLOWED_EMAILS / SMTP_FROM)

# --- Reserved for the future Twilio SMS/MMS channel (not yet active) ---------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=                               # your Twilio number, e.g. +15551234567

# --- Spell-correction (fuzzy title/author fix before searching) -------------
# Misspelled requests are corrected against an external book repository before
# the Mobilism scrape. Open Library is used for free (no key). Google Books has
# stronger typo tolerance but anonymous calls share a small daily quota and 429
# readily — set a key for reliable correction. Optional; leave blank to rely on
# Open Library. Get one at https://console.cloud.google.com (enable Books API).
# GOOGLE_BOOKS_API_KEY=

# --- New-release list radar (issue #33) --------------------------------------
# Follows NYT fiction bestseller lists, auto-watches new entrants, downloads
# them when they hit Mobilism, and emails a digest of activity. Free key from
# https://developer.nytimes.com (enable the Books API). Blank = feature off.
# NYT_API_KEY=

# --- Book storage (local disk or Cloudflare R2, issue #47) ------------------
# Where downloaded books live. Production (Docker) uses `r2`: a private
# Cloudflare R2 bucket, keys books/<filename> — the container has no books
# volume, so keep STORAGE=r2 there. `local` (the code default) = plain files in
# DOWNLOAD_PATH, for tests/local dev. History/tags keep the same
# /downloads/<file> identity in both modes. Moving books between the two is a
# manual copy (scripts/migrate-to-r2.js for local -> r2; see README "Book
# storage"). With STORAGE=r2, the app REFUSES TO START if any R2_* is missing.
STORAGE=r2
R2_ACCOUNT_ID=                              # Cloudflare account id (R2 S3 endpoint)
R2_ACCESS_KEY_ID=                           # bucket-scoped "Object Read & Write" R2 API token
R2_SECRET_ACCESS_KEY=                       # its secret — never commit real values
R2_BUCKET=                                  # e.g. bookhunt-library
# Optional, r2 only:
# STORAGE_STAGING_DIR=                      # scratch for in-flight downloads (default: OS tmp/bookhunt-staging)
# STORAGE_INDEX_REFRESH_MS=600000           # how often to re-list the bucket (10 min)
# STORAGE_STARTUP_TIMEOUT_MS=15000          # max wait for the first listing before serving anyway
