{
  "manifest_version": 3,
  "name": "BookHunt — Search on Amazon book pages",
  "version": "1.0.1",
  "description": "Adds a 'Search on BookHunt' button + right-click entry to Amazon book pages that opens your BookHunt search prefilled with the book's title and author.",
  "permissions": ["contextMenus", "scripting"],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.ca/*",
    "*://bookhunt.mooseflip.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.ca/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Search this book on BookHunt"
  },
  "icons": {}
}
