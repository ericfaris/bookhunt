{
  "name": "bookhunt",
  "version": "1.29.0",
  "private": true,
  "description": "Local web app to search the Mobilism ebook forum and download ePUBs",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "warm": "node src/warm.js",
    "install-browser": "playwright install chromium",
    "test": "STORAGE=local node --test test/*.test.js",
    "docker:up": "GIT_SHA=$(git rev-parse --short HEAD) BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ) docker compose up -d --build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "dotenv": "^18.0.0",
    "express": "^5.0.0",
    "http-proxy": "^1.18.1",
    "node-unrar-js": "^2.0.2",
    "nodemailer": "^10.0.0",
    "playwright": "^1.62.1"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
